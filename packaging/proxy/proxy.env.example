# Copy manually to ~/.config/quatrro/proxy.env and supply existing certificate paths.
# Defaults expose only loopback. Use an explicit LAN/VPN address to allow remote clients.
QUATRRO_TLS_HOST=localhost
QUATRRO_TLS_PORT=9443
QUATRRO_TLS_BIND=127.0.0.1
QUATRRO_HTTP_PORT=8791
QUATRRO_TLS_CERT=/absolute/path/to/fullchain.pem
QUATRRO_TLS_KEY=/absolute/path/to/private-key.pem
