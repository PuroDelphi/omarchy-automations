# Optional TLS ingress. Nothing installs or starts this configuration by default.
# Provide QUATRRO_TLS_CERT and QUATRRO_TLS_KEY explicitly.
{
	admin off
	persist_config off
	auto_https off
	servers {
		protocols h1 h2
		timeouts {
			read_header 5s
			read_body 10s
			write 15s
			idle 30s
		}
		max_header_size 16KB
	}
}

https://{$QUATRRO_TLS_HOST:localhost}:{$QUATRRO_TLS_PORT:9443} {
	bind {$QUATRRO_TLS_BIND:127.0.0.1}
	tls {$QUATRRO_TLS_CERT} {$QUATRRO_TLS_KEY} {
		protocols tls1.2 tls1.3
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Cache-Control no-store
	}
	@webhooks {
		method POST
		path_regexp hooks ^/hooks/[a-z][a-z0-9._-]{0,63}$
	}
	handle @webhooks {
		request_body {
			max_size 256KiB
		}
		reverse_proxy 127.0.0.1:{$QUATRRO_HTTP_PORT:8791} {
			transport http {
				dial_timeout 2s
				response_header_timeout 10s
			}
		}
	}
	handle {
		respond "Not found" 404
	}
}
