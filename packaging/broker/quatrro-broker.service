[Unit]
Description=Omarchy Automations optional administrative broker
Requires=quatrro-broker.socket
After=quatrro-broker.socket dbus.service polkit.service

[Service]
Type=exec
ExecStart=/usr/local/libexec/quatrro-broker
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
TasksMax=32
MemoryMax=128M
CPUQuota=25%
LimitNOFILE=128
TimeoutStopSec=5s
KillMode=control-group
Restart=no
StandardOutput=null
StandardError=journal
